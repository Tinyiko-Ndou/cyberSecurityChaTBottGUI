<Window x:Class="cyberSecurityChaTBottGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber Security Awareness Bot"
        Height="600"
        Width="850"
        Background="#1E1E1E">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Button Bar -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">

            <!-- Quiz Button -->
            <Button Content="🎮 Start Quiz"
                    Width="130"
                    Height="35"
                    Margin="0,0,8,0"
                    Background="#004400"
                    Foreground="Lime"
                    FontFamily="Consolas"
                    FontSize="13"
                    BorderBrush="Lime"
                    Click="QuizButton_Click"/>

            <!-- Tasks Button -->
            <Button Content="📋 Show Tasks"
                    Width="130"
                    Height="35"
                    Margin="0,0,8,0"
                    Background="#004400"
                    Foreground="Lime"
                    FontFamily="Consolas"
                    FontSize="13"
                    BorderBrush="Lime"
                    Click="TasksButton_Click"/>

            <!-- Add Task Button -->
            <Button Content="➕ Add Task"
                    Width="130"
                    Height="35"
                    Margin="0,0,8,0"
                    Background="#004400"
                    Foreground="Lime"
                    FontFamily="Consolas"
                    FontSize="13"
                    BorderBrush="Lime"
                    Click="AddTaskButton_Click"/>

            <!-- Activity Log Button -->
            <Button Content="📜 Activity Log"
                    Width="130"
                    Height="35"
                    Margin="0,0,8,0"
                    Background="#004400"
                    Foreground="Lime"
                    FontFamily="Consolas"
                    FontSize="13"
                    BorderBrush="Lime"
                    Click="LogButton_Click"/>

            <!-- Help Button -->
            <Button Content="❓ Help"
                    Width="100"
                    Height="35"
                    Background="#004400"
                    Foreground="Lime"
                    FontFamily="Consolas"
                    FontSize="13"
                    BorderBrush="Lime"
                    Click="HelpButton_Click"/>

        </StackPanel>

        <!-- Chat Area -->
        <RichTextBox Name="ChatBox"
                     Grid.Row="1"
                     FontFamily="Consolas"
                     FontSize="14"
                     IsReadOnly="True"
                     Background="Black"
                     Foreground="Lime"
                     Margin="0,0,0,8"/>

        <!-- Quick Topic Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">

            <Button Content="🔐 Passwords"
                    Width="120"
                    Height="30"
                    Margin="0,0,8,0"
                    Background="#002200"
                    Foreground="Lime"
                    FontFamily="Consolas"
                    FontSize="12"
                    BorderBrush="#005500"
                    Click="PasswordButton_Click"/>

            <Button Content="🎣 Phishing"
                    Width="120"
                    Height="30"
                    Margin="0,0,8,0"
                    Background="#002200"
                    Foreground="Lime"
                    FontFamily="Consolas"
                    FontSize="12"
                    BorderBrush="#005500"
                    Click="PhishingButton_Click"/>

            <Button Content="🌐 Safe Browsing"
                    Width="130"
                    Height="30"
                    Margin="0,0,8,0"
                    Background="#002200"
                    Foreground="Lime"
                    FontFamily="Consolas"
                    FontSize="12"
                    BorderBrush="#005500"
                    Click="BrowsingButton_Click"/>

            <Button Content="🔑 2FA"
                    Width="80"
                    Height="30"
                    Margin="0,0,8,0"
                    Background="#002200"
                    Foreground="Lime"
                    FontFamily="Consolas"
                    FontSize="12"
                    BorderBrush="#005500"
                    Click="TwoFAButton_Click"/>

            <Button Content="🦠 Malware"
                    Width="100"
                    Height="30"
                    Background="#002200"
                    Foreground="Lime"
                    FontFamily="Consolas"
                    FontSize="12"
                    BorderBrush="#005500"
                    Click="MalwareButton_Click"/>

        </StackPanel>

        <!-- Input Area -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal">

            <TextBox Name="UserInput"
                     Width="695"
                     Height="35"
                     FontSize="14"
                     FontFamily="Consolas"
                     Background="#0d0d0d"
                     Foreground="White"
                     CaretBrush="Lime"
                     BorderBrush="#333333"
                     Margin="0,0,10,0"/>

            <Button Content="Send"
                    Width="100"
                    Height="35"
                    Background="#006600"
                    Foreground="Lime"
                    FontFamily="Consolas"
                    FontSize="14"
                    BorderBrush="Lime"
                    Click="SendButton_Click"/>

        </StackPanel>

    </Grid>
</Window>