<Window x:Class="cyberSecurityChaTBottGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber Security Awareness Bot"
        Height="500"
        Width="800"
        Background="#1E1E1E">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Chat Area -->
        <RichTextBox Name="ChatBox"
             FontFamily="Consolas"
             FontSize="14"
             IsReadOnly="True"
             Background="Black"
             Foreground="Lime"/>
        <!-- Input Area -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal">

            <TextBox Name="UserInput"
                     Width="650"
                     Height="35"
                     FontSize="14"
                     Margin="0,0,10,0"/>

            <Button Content="Send"
                    Width="100"
                    Height="35"
                    Click="SendButton_Click"/>
        </StackPanel>

    </Grid>
</Window>